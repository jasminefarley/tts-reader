{
  "manifest_version": 3,
  "name": "tts-reader",
  "version": "0.3.0",
  "description": "Reads pages, selections or pasted text aloud with a local voice, highlighting each sentence as it's spoken.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "scripting", "activeTab", "contextMenus", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://claude.ai/*",
    "https://*.claudeusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open tts-reader" },
  "background": { "service_worker": "background.js", "type": "module" }
}
